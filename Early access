        mt.__index = newcclosure(function(self, key)
            if antiBanEnabled and tostring(key):lower():find("ban") then
                warn("[PROTECTION] Blocked a suspicious Ban check/property read.")
            end
            return oldIndex(self, key)
        end)

        if setreadonly then setreadonly(mt, true) end
    end
end)

