-- ENGINE FOR TRADE VALUE CALCULATION
task.spawn(function()
    while true do
        if autoValueCheckEnabled then
            pcall(function()
                local myTotal = 0
                local opponentTotal = 0

                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("Model") and (obj.Name:lower():find("board") or obj.Name:lower():find("trade")) then
                        for _, item in ipairs(obj:GetChildren()) do
                            local valAttr = item:GetAttribute("Value") or item:FindFirstChild("Value")
                            local valNum = tonumber(valAttr and (type(valAttr) == "number" and valAttr or valAttr.Value)) or 100
                            
                            if item:IsDescendantOf(obj) then
                                myTotal = myTotal + valNum
                            end
                        end
                    end
                end

                local status = "Neutral"
                if myTotal > opponentTotal then
                    status = "WIN (+ " .. (myTotal - opponentTotal) .. ")"
                elseif opponentTotal > myTotal then
                    status = "LOSE (- " .. (opponentTotal - myTotal) .. ")"
                end

                tradeValParagraph:SetDesc(string.format("Your Side Est. Value: $%d\nTheir Side Est. Value: $%d\nStatus: %s", myTotal, opponentTotal, status))
            end)
        end
        task.wait(1)
    end
end)

